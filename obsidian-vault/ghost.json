{
  "schemaVersion": 3,
  "minCindyVersion": "0.1.143",
  "id": "obsidian-vault",
  "name": "Obsidian 知识库",
  "description": "在 Cindy 中搜索和引用本机 Obsidian 笔记，沿双链浏览，把对话保存到知识库，或快速记录今日日记。",
  "whenToUse": "用户想查询、搜索、阅读、整理、创建或修改 Obsidian 笔记与知识库（Vault）、每日日记（Daily Note）、双链与反向链接、标签属性、Canvas 思维白板，或将对话结论存入第二大脑时找我",
  "icon": "assets/icon.png",
  "readme": {
    "en": "README.md",
    "zh-CN": "README.zh-CN.md"
  },
  "locales": {
    "en": "locales/en.json",
    "zh-CN": "locales/zh-CN.json",
    "ja": "locales/ja.json",
    "ko": "locales/ko.json"
  },
  "version": "1.5.0",
  "releaseNotes": "工作台显示知识库所在电脑。笔记和日记的写入回执保存在执行电脑，断线后可查询原请求，重试不会重复追加。新增每个知识库的只读开关和目录级写入范围，覆盖笔记、日记、Canvas 和回收站。新增 Frontmatter 标签按完整标签名添加、移除和列出。包含 1.2.0 的目录与搜索增强、1.3.0 的标题路径和块编辑，以及 1.1.1 的回复入库修复。",
  "entry": "main.js",
  "launch": "on-demand",
  "command": "obsidian",
  "confirm": true,
  "pick": true,
  "settingsHtml": "settings.html",
  "node": {
    "entry": "node/worker.cjs",
    "protocol": "json-rpc-stdio",
    "lifecycle": "on-demand",
    "idleTimeoutSeconds": 120
  },
  "manual": {
    "items": [
      {
        "dir": "manual/guide",
        "name": "guide",
        "description": "多工具编排原则：知识图谱检索、章节级非破坏性编辑与 Canvas 白板生成指南"
      }
    ]
  },
  "skill": {
    "items": [
      {
        "dir": "skills/obsidian-capture",
        "name": "obsidian-capture",
        "description": "将当前对话结论、网页调研或代码方案提炼为结构化 Obsidian 笔记，自动搜索既有相关笔记建立 [[双链]] 与 YAML Frontmatter 属性后存入知识库。"
      },
      {
        "dir": "skills/obsidian-daily",
        "name": "obsidian-daily",
        "description": "读取、汇总或更新 Obsidian 今日日记（Daily Note），支持早间待办梳理、晚间工作复盘以及将近期新增笔记关联进今日记录。"
      }
    ]
  },
  "tools": [
    {
      "name": "vault_status",
      "description": "查看本机已登记的 Obsidian 知识库（Vault）列表、当前激活库统计（笔记数、双链数、未完待办、高频 #标签、日记与收件箱目录配置、近期修改笔记）及 Obsidian CLI 在线状态。",
      "parameters": {
        "type": "object",
        "properties": {
          "vault": {
            "type": "string",
            "description": "可选：指定已登记知识库的 ID、名称或路径；省略时使用默认库"
          },
          "refresh": {
            "type": "boolean",
            "description": "可选：是否强制重新扫描磁盘索引"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "list_notes",
      "description": "列出已登记知识库内的子目录和文件。支持相对目录、深度和扩展名过滤，仅扫描目录元数据。",
      "parameters": {
        "type": "object",
        "properties": {
          "folder": {
            "type": "string",
            "description": "库内相对目录。省略或传空字符串从根目录开始。"
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 1,
            "description": "目录深度。1 只列直接子项。"
          },
          "extension": {
            "type": "string",
            "description": "可选文件扩展名，如 md 或 .canvas。目录始终返回。"
          },
          "vault": {
            "type": "string",
            "description": "已登记知识库的 ID、名称或路径，默认为当前默认库。"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "search_notes",
      "description": "搜索笔记，支持关键词、目录、标签和属性过滤，按相关性排序并分页。每条结果可返回正文命中位置。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "搜索关键词（多个词以空格分隔，同时匹配标题、别名、标签、章节与正文）"
          },
          "folder": {
            "type": "string",
            "description": "限定子目录前缀，例如 Projects 或 AIOS"
          },
          "tag": {
            "type": "string",
            "description": "按标签过滤（支持嵌套标签前缀，无需带 # 号）"
          },
          "propertyKey": {
            "type": "string",
            "description": "按 YAML Frontmatter 属性名过滤，例如 author 或 status"
          },
          "propertyValue": {
            "type": "string",
            "description": "Frontmatter 属性值包含的文本"
          },
          "limit": {
            "type": "number",
            "description": "每页条数（1–50，默认 15）。"
          },
          "refresh": {
            "type": "boolean",
            "description": "可选：搜索前是否强制刷新缓存索引"
          },
          "vault": {
            "type": "string",
            "description": "可选：已登记的目标知识库 ID 或名称"
          },
          "cursor": {
            "type": "string",
            "maxLength": 128,
            "description": "续页时原样传回 nextCursor，查询及每页大小须一致。"
          },
          "maxMatchesPerNote": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 8,
            "description": "每篇笔记返回的正文命中上限，1–20，默认 8。"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "read_note",
      "description": "读取整篇 Obsidian 笔记、标题章节或 ^块 ID。headings 返回每个标题的完整路径，可用于定位重名章节。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "精确笔记相对路径（如 AIOS/调研.md，不做模糊猜测）；未知完整路径时请改传 title"
          },
          "title": {
            "type": "string",
            "description": "笔记标题、别名或 [[双链名]]（自动按 Obsidian 规则定位；若重名会提示候选路径）"
          },
          "heading": {
            "type": "string",
            "description": "可选：仅读取该 Markdown 章节标题下的内容（支持带 ## 层级消歧，自动忽略代码块内的 # 注释）"
          },
          "maxChars": {
            "type": "number",
            "description": "最大返回字符数（500–120000，默认 40000）"
          },
          "vault": {
            "type": "string",
            "description": "可选：已登记的目标知识库 ID 或名称"
          },
          "headingPath": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "完整标题路径，例如 [\"项目 A\", \"结论\"]。与 heading 和 blockId 互斥。"
          },
          "blockId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 129,
            "description": "Obsidian 块 ID，例如 ^meeting-summary。与 heading 和 headingPath 互斥。"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "write_note",
      "description": "创建或编辑 Obsidian 笔记，支持正文、标题路径、块 ID 和 Frontmatter。覆盖已有笔记及移入回收站前需要 Cindy 确认。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "目标 .md 笔记相对路径（如 Inbox/总结.md，自动补齐 .md）"
          },
          "mode": {
            "type": "string",
            "enum": [
              "create",
              "append",
              "prepend",
              "append-heading",
              "prepend-heading",
              "replace-section",
              "update-frontmatter",
              "overwrite",
              "delete",
              "append-block",
              "prepend-block",
              "replace-block"
            ],
            "description": "标题写入用 append-heading、prepend-heading 或 replace-section，块写入用 append-block、prepend-block 或 replace-block。"
          },
          "heading": {
            "type": "string",
            "description": "当 mode 为 append-heading / prepend-heading / replace-section 时必填的目标章节名（同名章节可带 ## 层级消歧；不存在时自动在末尾安全新建二级标题）"
          },
          "content": {
            "type": "string",
            "description": "要写入或追加的 Markdown 正文（支持 [[双链]]、#标签、Callout）"
          },
          "frontmatter": {
            "type": "object",
            "description": "可选：要按顶层键增量合并写入 YAML Frontmatter 的标量/标量数组对象（传 null 值可移除对应键）"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "可选：要合并加入 Frontmatter tags 的标签数组"
          },
          "idempotencyKey": {
            "type": "string",
            "maxLength": 128,
            "description": "可选：跨重试防重复追加的幂等请求编号"
          },
          "vault": {
            "type": "string",
            "description": "可选：已登记的目标知识库 ID 或名称"
          },
          "headingPath": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "完整标题路径，例如 [\"项目 A\", \"结论\"]。与 heading 和 blockId 互斥。"
          },
          "blockId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 129,
            "description": "Obsidian 块 ID，例如 ^meeting-summary。与 heading 和 headingPath 互斥。"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "replace_in_note",
      "description": "按字面文本在整篇正文、指定章节或块内替换。默认只允许唯一命中，dryRun 可先核对数量。保留 Frontmatter，可用 mtimeMs 防止预览后目标变化。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "find",
          "replace"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "既有笔记的精确库内相对路径。"
          },
          "vault": {
            "type": "string",
            "description": "已登记知识库 ID、名称或路径。"
          },
          "heading": {
            "type": "string",
            "description": "可选的标题名，与 headingPath 和 blockId 互斥。"
          },
          "headingPath": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "完整标题路径，例如 [\"项目 A\", \"结论\"]。与 heading 和 blockId 互斥。"
          },
          "blockId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 129,
            "description": "Obsidian 块 ID，例如 ^meeting-summary。与 heading 和 headingPath 互斥。"
          },
          "find": {
            "type": "string",
            "minLength": 1,
            "description": "要查找的字面文本，区分大小写。"
          },
          "replace": {
            "type": "string",
            "description": "替换文本。空字符串表示移除匹配文本。"
          },
          "replaceAll": {
            "type": "boolean",
            "default": false,
            "description": "仅当确实需要时设为 true，以替换范围内所有匹配。"
          },
          "expectedCount": {
            "type": "integer",
            "minimum": 1,
            "description": "可选，写入前要求匹配数量等于此值。"
          },
          "dryRun": {
            "type": "boolean",
            "default": false,
            "description": "只返回匹配数量、范围和文件修改时间，不写入。"
          },
          "expectedMtimeMs": {
            "type": "number",
            "description": "可选，传入读取或预览返回的 mtimeMs；目标已变化时拒绝写入。"
          },
          "idempotencyKey": {
            "type": "string",
            "maxLength": 128,
            "description": "可选，同一写入重试时重复使用同一键。"
          }
        }
      }
    },
    {
      "name": "daily_note",
      "description": "读取、自动初始化或向 Obsidian 每日日记（Daily Note，遵循 .obsidian/daily-notes.json 或插件设置中的目录、日期格式与模板）单次原子追加时间戳记录或待办事项。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "read",
              "ensure",
              "append",
              "add-task"
            ],
            "description": "read=仅只读查看（不存在时不落盘）；ensure=不存在则按模板初始化；append=追加带时间戳的记录；add-task=追加 - [ ] 待办"
          },
          "date": {
            "type": "string",
            "description": "可选：严格的 YYYY-MM-DD 日历日期，省略时使用本机当前日期"
          },
          "content": {
            "type": "string",
            "description": "当 action 为 append 或 add-task 时必填的文本内容"
          },
          "heading": {
            "type": "string",
            "description": "可选：追加到日记内的指定章节标题下"
          },
          "timestamp": {
            "type": "boolean",
            "description": "append 时是否自动加 HH:mm 时间前缀（默认 true）"
          },
          "idempotencyKey": {
            "type": "string",
            "maxLength": 128,
            "description": "可选：防重复提交的幂等请求编号"
          },
          "vault": {
            "type": "string",
            "description": "可选：已登记的目标知识库 ID 或名称"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "graph_links",
      "description": "遍历 Obsidian 知识图谱连接：查询单篇笔记的 [[出链]]/![[嵌入]]、反向链接（Backlinks）、未连接提及（Unlinked Mentions）与二跳关联笔记，或查看全库核心枢纽（hubs）、孤立笔记（orphans）与标签聚合（tags）。",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "note",
              "hubs",
              "orphans",
              "tags"
            ],
            "description": "note=分析指定笔记的连接网络（默认）；hubs=连接度最高的核心笔记；orphans=无双向链接的孤立笔记；tags=全库标签分布"
          },
          "path": {
            "type": "string",
            "description": "mode=note 时的精确笔记相对路径"
          },
          "title": {
            "type": "string",
            "description": "mode=note 时的目标笔记标题（同名时将提示候选路径）"
          },
          "limit": {
            "type": "number",
            "description": "返回条数上限（1–100，默认 25）"
          },
          "refresh": {
            "type": "boolean",
            "description": "可选：是否强制刷新索引"
          },
          "vault": {
            "type": "string",
            "description": "可选：已登记的目标知识库 ID 或名称"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "canvas_ops",
      "description": "列出、读取、新建或增量合并 Obsidian Canvas 思维白板（.canvas 文件）：支持 text/file/link/group 节点并完整保留已有扩展字段；整板覆盖（overwrite）前需经用户弹窗确认。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "read",
              "create",
              "upsert",
              "overwrite",
              "write"
            ],
            "description": "list=列出所有白板；read=读取完整白板 JSON；create=仅新建（同名报错）；upsert=按 id 无损合并更新节点与边（write 等价于不存在新建、已存在 upsert）；overwrite=整板替换（会弹确认框）"
          },
          "path": {
            "type": "string",
            "description": "白板相对路径（如 架构梳理.canvas）"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "节点数组，支持 {id, type:'text'|'file'|'link'|'group', text?, file?, subpath?, url?, label?, background?, x?, y?, width?, height?, color?}"
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "连线数组，支持 {id?, fromNode, toNode, fromSide?, toSide?, fromEnd?, toEnd?, color?, label?}"
          },
          "removeNodeIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "upsert 模式下要显式移除的节点 id 列表"
          },
          "removeEdgeIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "upsert 模式下要显式移除的连线 id 列表"
          },
          "vault": {
            "type": "string",
            "description": "可选：已登记的目标知识库 ID 或名称"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "open_in_obsidian",
      "description": "经路径安全校验后，在桌面端 Obsidian 应用中唤起并定位打开已存在的笔记或白板（优先使用已启用 CLI，否则使用精确路径 obsidian://open?path=... URI）。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "可选：要打开的库内相对路径；省略时打开对应 Vault"
          },
          "vault": {
            "type": "string",
            "description": "可选：已登记的目标知识库 ID 或名称"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "open_workbench",
      "description": "在聊天或侧栏打开 Obsidian 知识库交互工作台页面（当用户要求打开可视化面板浏览笔记、预览双链、手动编辑入库或查看今日日记面板时调用）。",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "browse",
              "capture",
              "daily"
            ],
            "description": "初始打开的页签"
          },
          "path": {
            "type": "string",
            "description": "可选：初始预览的笔记精确路径"
          },
          "title": {
            "type": "string",
            "description": "可选：初始预览的笔记标题"
          },
          "query": {
            "type": "string",
            "description": "可选：初始搜索词"
          },
          "vault": {
            "type": "string",
            "description": "可选：已登记的目标知识库 ID 或名称"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "complete_notes",
      "description": "仅供输入框 @ 补全与工作台页面调用：实时返回匹配的 Obsidian 笔记双链候选项（重名笔记自动附带路径消歧）。模型日常检索请调用 search_notes 或 open_workbench。",
      "approval": "auto",
      "parameters": {
        "type": "object",
        "properties": {
          "trigger": {
            "type": "string",
            "enum": [
              "@",
              "/"
            ],
            "description": "触发字符"
          },
          "query": {
            "type": "string",
            "description": "用户当前输入的查询词"
          }
        },
        "required": [
          "trigger",
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pick_vault_dir",
      "description": "仅供工作台页面调用：弹出系统文件夹选择器登记并切换默认 Obsidian Vault 目录。模型打开界面请调用 open_workbench。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "manage_tags",
      "description": "按完整标签名列出、添加或移除指定 Markdown 笔记的 Frontmatter 标签。匹配忽略大小写，保留正文与其他属性。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "operation"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "既有 Markdown 笔记的库内相对路径。"
          },
          "vault": {
            "type": "string",
            "description": "已登记知识库的 ID、名称或路径。"
          },
          "operation": {
            "type": "string",
            "enum": [
              "list",
              "add",
              "remove"
            ],
            "description": "list 列出标签。add 和 remove 修改标签。"
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string"
            },
            "description": "添加或移除时填写完整标签名。可带 #，不会匹配同名标签的子标签。"
          }
        }
      }
    },
    {
      "name": "write_receipt",
      "description": "仅供工作台调用。按原知识库 ID、工具和请求编号，只读检查一次笔记或日记的写入回执。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vault",
          "method",
          "idempotencyKey"
        ],
        "properties": {
          "vault": {
            "type": "string",
            "description": "写入请求使用的知识库 ID。"
          },
          "method": {
            "type": "string",
            "enum": [
              "write_note",
              "daily_note"
            ],
            "description": "原写入请求使用的工具。"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "原写入请求的编号。"
          }
        }
      }
    },
    {
      "name": "set_vault_write_policy",
      "description": "仅供工作台调用。经 Cindy 确认后保存已登记知识库的只读状态和写入目录范围。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vault",
          "readOnly",
          "restrictFolders",
          "folders"
        ],
        "properties": {
          "vault": {
            "type": "string",
            "description": "已登记目标知识库。"
          },
          "readOnly": {
            "type": "boolean",
            "description": "设为 true 时拒绝目标库写入。"
          },
          "restrictFolders": {
            "type": "boolean",
            "description": "设为 true 时只允许在 folders 指定的目录下写入。"
          },
          "folders": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 240
            },
            "description": "相对于知识库的目录路径，包含其子目录。空列表表示拒绝所有写入。"
          }
        }
      }
    }
  ],
